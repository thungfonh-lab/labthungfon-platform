# ---- Google Sheets backend ----
# Full JSON contents of the service account key file, as a single-line JSON string.
# NEVER commit the actual key file or its contents — only reference it through this env var.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
GOOGLE_SHEETS_ID=1FB4LEHlrT29cxi0tn8S-2UztTQt8FGQifkN79higYP4

# ---- Auth (stateless JWT sessions, replaces GAS CacheService sessions) ----
JWT_SECRET=change-me-to-a-long-random-string

# ---- CORS ----
# Comma-separated list of allowed origins, or "*" to allow all (default).
CORS_ORIGIN=*

# ---- Email notifications (NotificationService) ----
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
MAIL_PASS=
MAIL_FROM="labthungfon Platform <no-reply@example.com>"

# ---- LINE Notify (NotificationService) ----
# Optional: if not set, settings.lineToken from the Settings sheet is used per-org instead.
LINE_TOKEN=

# ---- Backups (new feature — see README) ----
# Drive folder ID where spreadsheet backups are copied to. Create a folder in your
# own Google Drive, share it with the service account's client_email (Editor), then
# paste the folder ID from its URL here. Without this, /api/backups returns a
# clear setup error instead of creating backups.
GOOGLE_BACKUP_FOLDER_ID=

# ---- Cron (Vercel Cron Jobs — daily backup, weekly audit-log purge) ----
# Vercel auto-sends this as `Authorization: Bearer <value>` on cron-triggered
# requests when this env var is set. Generate any long random string.
CRON_SECRET=change-me-to-a-long-random-string

# ---- Local dev ----
PORT=3000
